# Copie este archivo como .env (nunca lo suba a Git) o cárguelo como
# "App Settings" en Azure App Service.

# --- Microsoft Foundry ----------------------------------------------------
# Formato: https://<nombre-recurso>.services.ai.azure.com/api/projects/<proyecto>
# OJO: el endpoint del PROYECTO lleva /api/projects/<proyecto>, y NO es el mismo
# que el del RECURSO (que se usa en Content Understanding, más abajo).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_AGENT_NAME=rio-claro-agent

# Modelo de generación de imágenes (tarea «Hablar por voz» del portal).
# OJO: dall-e-3 se retiró el 4 de marzo de 2026. Debe usar la serie gpt-image.
#   gpt-image-2.5-flare   -> disponibilidad general, sin trámite (recomendado)
#   gpt-image-2.5-sunburst-> disponibilidad general
#   gpt-image-2           -> disponibilidad general
#   gpt-image-1 / -mini   -> requieren solicitar acceso (acceso limitado)
# El valor debe coincidir con el NOMBRE DEL DESPLIEGUE, no con el del modelo.
#
# AVISO: muchas suscripciones (incluidas las de estudiante) tienen cuota 0 para
# TODOS los modelos de imagen. La generación es la única función opcional del
# proyecto: el resto del portal funciona igual sin ella.
FOUNDRY_IMAGE_MODEL=gpt-image-2.5-flare

# --- Content Understanding (Foundry Tools) --------------------------------
# Endpoint del RECURSO, no del proyecto (sin /api/projects/).
# Verificado: con el endpoint del proyecto la llamada falla con
# «Subdomain does not map to a resource», que no explica nada.
CONTENT_UNDERSTANDING_ENDPOINT=https://<nombre-recurso>.cognitiveservices.azure.com/
# Déjelo vacío para usar identidad administrada (recomendado)
CONTENT_UNDERSTANDING_KEY=

# --- Azure Speech (Foundry Tools) -----------------------------------------
SPEECH_KEY=
# Debe ser una región que su suscripción permita Y donde exista Speech.
# westus funciona tanto en suscripciones de estudiante como en pago por uso.
# Compruebe las regiones permitidas con:
#   az policy assignment show --name sys.regionrestriction
SPEECH_REGION=westus

# --- Azure AI Language (Foundry Tools) ------------------------------------
LANGUAGE_ENDPOINT=https://<nombre-recurso>.cognitiveservices.azure.com/
LANGUAGE_KEY=

# --- Azure Key Vault (opcional, recomendado en producción) ----------------
# Si define esta variable, la app lee los secretos de Key Vault con
# identidad administrada en lugar de variables de entorno.
KEY_VAULT_URI=
